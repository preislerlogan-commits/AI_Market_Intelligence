# Virtual environments
.venv/

# Python bytecode/cache
__pycache__/
*.pyc
*.egg-info/

# Environment files / secrets
.env
.env.*
!.env.example
*.key
*.pem

# Data directories (keep .gitkeep so structure is tracked)
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# Local agent-evaluation characterization inputs/outputs (never committed).
# Only synthetic fixtures under market_intelligence/evaluation/fixtures/ are
# tracked; real characterization inputs and outputs must remain local here.
data/evaluations/local/*
!data/evaluations/local/.gitkeep

# Databases
*.duckdb
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/
