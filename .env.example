ALPACA_API_KEY=
ALPACA_API_SECRET=
FRED_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override for this project's local data directory. Defaults to
# data/ (relative to the repository root) if unset.
PROJECT_DATA_PATH=data

# Optional OpenAI structured-output request configuration (non-secret).
# If unset, Settings now falls back to these same values as its own
# built-in defaults (see market_intelligence/config/settings.py) --
# they are shown explicitly below for visibility, and can still be
# overridden here. The News Analyst's first completed live run
# (2026-08-24, symbol SPY, limit=5) required both of these values: two
# live attempts under the prior built-in defaults (30s timeout, 2048
# tokens) failed first (an "incomplete" response at
# max_output_tokens=2048, then a local timeout at the default 30-second
# timeout once max_output_tokens was raised to 4096) -- see
# docs/NEWS_ANALYST.md's "Live run sequence and manual quality review"
# section and PROJECT_STATE.md for the full, dated record.
OPENAI_MODEL=gpt-5-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=4096
